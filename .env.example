# Copy this file to .env and fill in real values. Never commit .env itself.

# Local dev: matches docker-compose.yml. Production: connection string from Neon/Supabase.
DATABASE_URL="postgresql://geodex:geodex_dev_password@localhost:5442/geodex?schema=public"

# Auth.js secret used to sign/encrypt session tokens. Generate with:
#   npx auth secret
# or:
#   openssl rand -base64 32
AUTH_SECRET=""

# Feedback / bug reports (POST /api/feedback). Reports are always saved to the
# database; these settings additionally email each one to you. Leave them
# unset to skip email (reports are still stored). Any SMTP provider works.
# Gmail: turn on 2-step verification, create an "App password"
# (https://myaccount.google.com/apppasswords), and use it as SMTP_PASS.
# Where reports are delivered:
FEEDBACK_TO_EMAIL=you@example.com
SMTP_HOST=smtp.gmail.com
# 587 (STARTTLS) is the default; use 465 for implicit TLS (SMTP_SECURE is then true).
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
# Optional: the From address (defaults to SMTP_USER) and an explicit TLS override.
# FEEDBACK_FROM_EMAIL=you@gmail.com
# SMTP_SECURE=false

# The site's public address, for the sitemap, robots.txt and link-preview cards.
# Set it once the real domain exists. Until then Netlify's own URL variable is
# used when deployed, and http://localhost:3000 locally.
# NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Optional public contact address shown on the privacy policy and terms pages for
# privacy requests. Leave it unset to point people to the in-app feedback window
# instead, so no personal address is published by accident.
# NEXT_PUBLIC_CONTACT_EMAIL=privacy@your-domain.example
