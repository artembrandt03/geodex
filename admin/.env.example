# Copy this file to admin/.env (which git ignores) and fill it in. Every setting is optional:
# with nothing set, the dashboard reads your local development database on port 4000.

# The database the dashboard reads. Default: the local Docker database (geodex).
# For production, create the read-only login with admin/sql/create-readonly-role.sql and put
# ITS connection string here, never the app's own (read/write) one.
# ADMIN_DATABASE_URL=postgresql://geodex_admin_ro:PASSWORD@your-host/geodex?sslmode=require

# The database `npm run admin:demo` reads (and `npm run admin:seed-demo` fills). Must be named *_demo.
# ADMIN_DEMO_DATABASE_URL=postgresql://geodex:geodex_dev_password@localhost:5442/geodex_demo?schema=public

# Where the dashboard listens (always on 127.0.0.1, this computer only).
# ADMIN_PORT=4000

# Only used to draw the "email budget" gauge. Keep in step with EMAIL_DAILY_LIMIT in the app's .env.
# ADMIN_EMAIL_DAILY_LIMIT=400
