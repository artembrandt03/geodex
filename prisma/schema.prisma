// Prisma schema for Geodex.
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A registered player. Guests never get a User row — guest play isn't persisted.
model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  displayName     String
  /// Whether other players can open this profile from the leaderboard. On by
  /// default; the owner can turn it off from their profile.
  profilePublic   Boolean   @default(true)
  /// When the owner proved they control this address by clicking the link we
  /// emailed. Null means unconfirmed: that account cannot log in yet. Accounts
  /// that existed before verification was added were marked confirmed.
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  gameResults GameResult[]
  feedback    Feedback[]
  emailTokens EmailToken[]
}

enum EmailTokenKind {
  VERIFY_EMAIL
  RESET_PASSWORD
}

/// A single-use link emailed to a user (confirm the address, or reset the
/// password). Only a SHA-256 of the token is stored, so a database leak does
/// not hand out working links; the row is deleted once used.
model EmailToken {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      EmailTokenKind
  tokenHash String         @unique
  expiresAt DateTime
  createdAt DateTime       @default(now())

  @@index([userId, kind])
  @@index([expiresAt])
}

/// Country reference/seed data used to generate rounds.
/// `code` is the ISO 3166-1 alpha-3 code, matching the id field in the
/// world-atlas TopoJSON we render on the map (see prisma/seed.ts).
model Country {
  code           String     @id // ISO 3166-1 alpha-3, e.g. "CAN"
  name           String
  difficultyTier Difficulty

  @@index([difficultyTier])
}

/// One completed round, always tied to a registered user (guests aren't stored).
model GameResult {
  id             String     @id @default(cuid())
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode           GameMode
  difficulty     Difficulty
  roundLength    Int
  score          Int
  correct        Int
  /// Total time spent answering (excludes pauses on the reveal screen). 0 on
  /// rounds saved before the stopwatch existed, so treat 0 as "unknown".
  totalTimeMs    Int        @default(0)
  /// Longest run of consecutive correct answers in the round.
  bestStreak     Int        @default(0)
  /// Wrong guesses that were a neighbor of the right answer.
  neighborCount  Int        @default(0)
  /// Which scoring rules produced `score` (see SCORING_VERSION in
  /// lib/game/scoring.ts). Leaderboards and stats only use the current one,
  /// since scores under different rules aren't comparable. Rows from before
  /// versioning are 1.
  scoringVersion Int        @default(1)
  /// Id of the server-issued round token this result came back with (see
  /// lib/game/roundToken.ts). Unique, so a token, and the result it vouches for,
  /// can only be saved once. Null on rounds saved before tokens existed.
  roundNonce     String?    @unique
  createdAt      DateTime   @default(now())

  // Powers "top score per user per mode/difficulty/roundLength" leaderboard queries.
  @@index([mode, difficulty, roundLength, score])
  // Powers a player's own history and stats (newest first).
  @@index([userId, createdAt])
}

enum GameMode {
  NAME
  SHAPE
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum FeedbackKind {
  BUG
  FEEDBACK
}

/// A bug report or free-form feedback sent from the title screen. It's emailed
/// to the maintainer, but also stored here so nothing is lost if the email
/// fails, and so the submit endpoint can rate-limit by sender. Screenshots are
/// email-only (just counted here).
model Feedback {
  id              String       @id @default(cuid())
  kind            FeedbackKind
  subject         String
  description     String
  /// Set when the sender was signed in; kept (as null) if the account is later deleted.
  userId          String?
  user            User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// HMAC of the sender's IP address, never the address itself. Only used for rate limiting.
  ipHash          String?
  userAgent       String?
  attachmentCount Int          @default(0)
  /// Null until the email goes out; `emailError` records why if it didn't.
  emailedAt       DateTime?
  emailError      String?
  createdAt       DateTime     @default(now())

  @@index([ipHash, createdAt])
}

/// One counted event for rate limiting (a failed login, a signup attempt...).
/// See lib/rateLimit.ts. `key` is an HMAC of what's being limited (an IP, an
/// email), never the raw value, and old rows are swept out as new ones arrive.
model RateLimitHit {
  id        String   @id @default(cuid())
  /// What's being limited, e.g. "login-fail:email".
  bucket    String
  key       String
  createdAt DateTime @default(now())

  @@index([bucket, key, createdAt])
  @@index([createdAt])
}
